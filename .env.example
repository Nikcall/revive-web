NUXT_PUBLIC_SITE_URL=http://localhost:3000
# Сервер Nuxt → Directus. Браузер этот URL не видит.
NUXT_DIRECTUS_URL=http://localhost:8055
# Сервер Nuxt → CRM public pricelist API (без авторизации)
NUXT_CRM_PUBLIC_PRICELIST_URL=http://127.0.0.1:3001/api/public/pricelist
# Сервер Nuxt → CRM client tracking API (без авторизации)
NUXT_CRM_TRACK_URL=http://127.0.0.1:3001
# Пусто = заявка не уходит в CRM, только stub (локальная разработка)
NUXT_CRM_LEADS_URL=
# Тот же ключ, что WEBSITE_LEADS_API_KEY в CRM
NUXT_CRM_LEADS_KEY=

DIRECTUS_URL=http://localhost:8055
DIRECTUS_ADMIN_EMAIL=admin@revive.su
DIRECTUS_ADMIN_PASSWORD=ReviveCmsLocal1!
DIRECTUS_KEY=replace-with-32-char-random-key-value
DIRECTUS_SECRET=replace-with-32-char-random-secret-val

POSTGRES_DB=revive_web
POSTGRES_USER=directus
POSTGRES_PASSWORD=directus_local_change_me
